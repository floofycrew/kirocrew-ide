{
  "name": "kirocrew-ide-bridge",
  "displayName": "KiroCrew",
  "description": "KiroCrew chat (tabbed, with per-project history), agents, approvals, and the Kiro spec / steering / skills / hooks workflow inside the IDE. Sessions run in the KiroCrew gateway and survive a dropped connection. Installed by the kirocrew-ide FloofyCrew mod. Unofficial.",
  "version": "0.38.1",
  "publisher": "kirocrew-ide",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "web"
  ],
  "browser": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Chat and sessions run in the KiroCrew gateway; the extension itself executes nothing from the workspace."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kirocrew",
          "title": "KiroCrew",
          "icon": "media/kiro.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "kirocrew-chat",
          "title": "KiroCrew Chat",
          "icon": "media/kiro.svg"
        }
      ]
    },
    "views": {
      "kirocrew-chat": [
        {
          "type": "webview",
          "id": "kirocrew.chat",
          "name": "Chat",
          "initialSize": 1
        }
      ],
      "kirocrew": [
        {
          "id": "kirocrew.specs",
          "name": "Specs"
        },
        {
          "id": "kirocrew.steering",
          "name": "Steering"
        },
        {
          "id": "kirocrew.skills",
          "name": "Skills"
        },
        {
          "id": "kirocrew.hooks",
          "name": "Agent Hooks"
        },
        {
          "id": "kirocrew.mcp",
          "name": "MCP Servers"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kirocrew.steering",
        "contents": "No steering documents yet. Steering files in `.kiro/steering/` tell the agent about this project in every session.\n[Generate steering docs](command:kirocrew.steering.generate)\nOr [create one by hand](command:kirocrew.steering.new).\nAlready have AGENTS.md, CLAUDE.md or Cursor / Cline / Continue / Copilot rules? [Import from other assistants](command:kirocrew.steering.import).",
        "when": "kirocrew.steering.empty"
      },
      {
        "view": "kirocrew.hooks",
        "contents": "No agent hooks yet. Hook files in `.kiro/hooks/` (or `~/.kiro/hooks/`) run a prompt or a shell command when a file is saved, a tool runs, a session starts, or on demand.\nHooks are executed by kiro-cli, not by this extension. [Documentation](https://kiro.dev/docs/hooks/)\n[Create a hook](command:kirocrew.hooks.new)"
      },
      {
        "view": "kirocrew.mcp",
        "contents": "No MCP servers configured. kiro-cli reads `.kiro/settings/mcp.json` (workspace) and `~/.kiro/settings/mcp.json` (global). This view is read-only.\n[Documentation](https://kiro.dev/docs/mcp/)"
      }
    ],
