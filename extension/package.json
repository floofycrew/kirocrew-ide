        {
          "command": "kirocrew.steering.refine",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]steering[\\\\/].+\\.md$/ && resourceExtname == .md",
          "group": "navigation"
        },
        {
          "command": "kirocrew.spec.previewToSide",
          "when": "editorLangId == markdown && resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks)\\.md$/ && !notebookEditorFocused",
          "alt": "kirocrew.spec.preview",
          "group": "navigation"
        },
        {
          "command": "kirocrew.spec.goto.requirements",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'requirements.md' && kirocrew.spec.specType != 'bugfix' && (kirocrew.spec.workflowType == 'requirements-first' || !kirocrew.spec.workflowType)",
          "group": "navigation@1"
        },
        {
          "command": "kirocrew.spec.goto.design",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'design.md' && kirocrew.spec.specType != 'bugfix' && (kirocrew.spec.workflowType == 'requirements-first' || !kirocrew.spec.workflowType)",
          "group": "navigation@2"
        },
        {
          "command": "kirocrew.spec.goto.tasks",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'tasks.md' && kirocrew.spec.specType != 'bugfix' && (kirocrew.spec.workflowType == 'requirements-first' || !kirocrew.spec.workflowType)",
          "group": "navigation@3"
        },
        {
          "command": "kirocrew.spec.goto.design",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'design.md' && kirocrew.spec.specType != 'bugfix' && kirocrew.spec.workflowType == 'design-first'",
          "group": "navigation@1"
        },
        {
          "command": "kirocrew.spec.goto.requirements",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'requirements.md' && kirocrew.spec.specType != 'bugfix' && kirocrew.spec.workflowType == 'design-first'",
          "group": "navigation@2"
        },
        {
          "command": "kirocrew.spec.goto.tasks",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'tasks.md' && kirocrew.spec.specType != 'bugfix' && kirocrew.spec.workflowType == 'design-first'",
          "group": "navigation@3"
        },
        {
          "command": "kirocrew.spec.goto.tasks",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'tasks.md' && kirocrew.spec.specType != 'bugfix' && kirocrew.spec.workflowType == 'fast-task'",
          "group": "navigation@1"
        },
        {
          "command": "kirocrew.spec.goto.requirements",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'requirements.md' && kirocrew.spec.specType != 'bugfix' && kirocrew.spec.workflowType == 'fast-task'",
          "group": "navigation@2"
        },
        {
          "command": "kirocrew.spec.goto.design",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'design.md' && kirocrew.spec.specType != 'bugfix' && kirocrew.spec.workflowType == 'fast-task'",
          "group": "navigation@3"
        },
        {
          "command": "kirocrew.spec.goto.bugfix",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'bugfix.md' && kirocrew.spec.specType == 'bugfix'",
          "group": "navigation@1"
        },
        {
          "command": "kirocrew.spec.goto.design",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'design.md' && kirocrew.spec.specType == 'bugfix'",
          "group": "navigation@2"
        },
        {
          "command": "kirocrew.spec.goto.tasks",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'tasks.md' && kirocrew.spec.specType == 'bugfix'",
          "group": "navigation@3"
        },
        {
          "command": "kirocrew.spec.syncDocument",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && kirocrew.spec.documentHasContent",
          "group": "navigation@4"
        },
        {
          "command": "kirocrew.spec.nextDocument",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename != 'tasks.md' && (kirocrew.spec.workflowType != 'fast-task' || resourceFilename != 'design.md')",
          "group": "navigation@5"
        },
        {
          "command": "kirocrew.spec.runAll",
          "when": "resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename == 'tasks.md'",
          "group": "navigation@6"
        }
      ],
      "editor/context": [
        {
          "submenu": "kirocrew.editorActions",
          "when": "editorHasSelection",
          "group": "navigation@9"
        }
      ],
      "kirocrew.editorActions": [
        { "command": "kirocrew.editor.ask", "group": "1_ask@1" },
        { "command": "kirocrew.editor.fixGrammar", "group": "2_edit@1" },
        { "command": "kirocrew.editor.writeComments", "group": "2_edit@2" },
        { "command": "kirocrew.editor.writeDocstring", "group": "2_edit@3" },
        { "command": "kirocrew.editor.fixCode", "group": "2_edit@4" },
        { "command": "kirocrew.editor.optimize", "group": "2_edit@5" },
        { "command": "kirocrew.editor.addCodeBlock", "group": "3_insert@1" }
      ],
      "terminal/context": [
        {
          "command": "kirocrew.terminal.sendToChat",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "kirocrew.explorer.addToChat",
          "when": "resourceScheme == file",
          "group": "7_modification@9"
        }
      ],
      "scm/title": [
        {
          "command": "kirocrew.scm.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "KiroCrew",
      "properties": {
        "kirocrew.agent": {
          "type": "string",
          "default": "",
          "description": "KiroCrew agent used for new chats and spec phases (empty = the crew's default)."
        },
        "kirocrew.specAgent": {
          "type": "string",
          "default": "",
          "description": "KiroCrew agent used to execute spec tasks (empty = same as kirocrew.agent)."
        },
        "kirocrew.specEngine": {
          "type": "string",
          "enum": ["kas", "gateway"],
          "default": "kas",
          "enumDescriptions": [
            "Spec actions call Kiro's own spec engine in kiro-cli on the gateway host (_kiro/spec/* over the hook's ACP child) and open as Kiro-mode tabs; falls back to the gateway when kiro-cli is unavailable or does not implement a spec method.",
            "Spec actions (create, Sync / Next, Start task, Run all) run as KiroCrew gateway sessions with the mod's own spec prompts on kirocrew.agent / kirocrew.specAgent."
          ],
          "description": "Which engine runs the spec actions: Kiro's own spec engine in kiro-cli (default, Kiro-mode tabs, falling back to the gateway when kiro-cli is not usable) or the KiroCrew gateway with the mod's own spec prompts."
        },
        "kirocrew.specAutopilot": {
          "type": "boolean",
          "default": true,
          "description": "Run spec tasks (Start task, Run all tasks) with Autopilot on, as Kiro's IDE does: every tool of that session is approved without asking, so a run-all goes through the whole task list without stopping."
        },
        "kirocrew.checkpoints": {
          "type": "boolean",
          "default": true,
          "description": "Take a workspace checkpoint before every chat turn so each message offers Revert changes (as Kiro's IDE does). A checkpoint is a git tree of the working tree written through a temporary index: your own index, HEAD, branches and stash are never touched; checkpoints are anchored under refs/kirocrew/checkpoints/ and pruned to 200 per repository. Folders that are not git repositories get no checkpoints."
        },
        "kirocrew.specAutoResume": {
          "type": "boolean",
          "default": true,
          "description": "When a task run's turn ends before the run finished (the host's turn time limit, a dropped connection, an error, or a model that simply stopped; judged from the [~] / [-] marks left in tasks.md), resume the run on its own: re-read tasks.md and send the run's request again from the next unfinished task. Off: the Resume run / Continue button does it by hand."
        },
        "kirocrew.specResumeLimit": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 20,
          "description": "How many times one task run resumes itself after an interrupted turn before it stops and waits for Resume run (3 = a run can span four turns)."
        },
        "kirocrew.throttleRetries": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "When the model provider throttles a turn (a rate refusal, not anything about the conversation), send the same turn again after a wait — 4 s, then 12 s, 30 s and a minute — up to this many times, on gateway chats and Kiro-mode sessions alike. The chat keeps working through the wait and says which retry it is. 0 turns this off and leaves the error in place. A spent usage limit and a model that is unavailable on the backend are never retried: waiting does not help either one."
        },
        "kirocrew.folderName": {
          "type": "string",
          "default": "KiroCrew IDE",
          "description": "Dashboard chat folder that sessions created from the IDE are grouped under."
        },
        "kirocrew.notifyApprovals": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification with Approve / Reject when a session waits for a tool approval."
        },
        "kirocrew.syncTheme": {
          "type": "boolean",
          "default": true,
          "description": "Follow a KiroCrew dashboard light/dark toggle made while the window is open with the workbench's stock theme (a theme you picked yourself is never changed; opening a window never changes the theme)."
        },
        "kirocrew.chatFontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "description": "Font size (px) of the messages in KiroCrew Chat; 0 = the workbench font size. Only the transcript changes, not the UI."
        },
        "kirocrew.chatWidth": {
          "type": "string",
          "enum": ["compact", "comfortable", "full"],
          "enumDescriptions": [
            "A centred reading column of 800px (816px for the composer), scaled by the message font size — the dashboard's Compact. A narrow pane is unaffected.",
            "84% of the pane (85% for the composer).",
            "92% of the pane (93% for the composer)."
          ],
          "default": "compact",
          "description": "How wide the messages run when the KiroCrew Chat pane is wide; the same three presets as the dashboard's Chat settings."
        },
        "kirocrew.toolCardDisplayMode": {
          "type": "string",
          "enum": ["collapseOnComplete", "alwaysExpanded"],
          "enumDescriptions": [
            "A tool row folds to its one-line header when the call returns; click the header to see its input and output. A row you opened or closed yourself is left as you set it.",
            "Tool rows open as they arrive and stay open with their input and output visible."
          ],
          "default": "collapseOnComplete",
          "description": "Whether finished tool rows in KiroCrew Chat stay open (Kiro's Tool Card Display Mode). Applies to the rows already on screen when changed."
        },
        "kirocrew.editorActions.prompts": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {},
          "markdownDescription": "Your own instruction for the actions of the editor's **KiroCrew** context menu, keyed by action id: `ask` (Ask about this), `fixGrammar` (Fix grammar and spelling), `writeComments` (Write comments), `writeDocstring` (Write a docstring), `fixCode` (Fix this code), `optimize` (Optimize this code). An id left out (or set to an empty string) keeps the built-in instruction. The selection travels with the message as a `#selection` context in every case."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "kirocrew.spec",
        "displayName": "Kiro Spec",
        "selector": [
          {
            "filenamePattern": "**/.kiro/specs/**/{requirements,design,tasks}.md"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "kirocrew.spec.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == kirocrew.spec"
      },
      {
        "command": "kirocrew.terminal.sendToChat",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "terminalFocus"
      },
      {
        "command": "kirocrew.chat.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "focusedView == kirocrew.chat"
      },
      {
        "command": "kirocrew.chat.prevTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "focusedView == kirocrew.chat"
      },
      {
        "command": "kirocrew.chat.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "focusedView == kirocrew.chat"
      },
      {
        "command": "kirocrew.chat.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "focusedView == kirocrew.chat"
      },
      {
        "command": "kirocrew.chat.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == kirocrew.chat"
      },
      {
        "command": "kirocrew.chat.approveAll",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "focusedView == kirocrew.chat"
      },
      {
        "command": "kirocrew.chat.rejectAll",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "focusedView == kirocrew.chat"
      },
      {
        "command": "kirocrew.spec.preview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == markdown && resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks)\\.md$/ && !notebookEditorFocused"
      },
      {
        "command": "kirocrew.spec.previewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == markdown && resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks)\\.md$/ && !notebookEditorFocused"
      },
      {
        "command": "kirocrew.spec.syncDocument",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && kirocrew.spec.documentHasContent && !notebookEditorFocused"
      },
      {
        "command": "kirocrew.spec.runAll",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && resourcePath =~ /[\\\\/]\\.kiro[\\\\/]specs[\\\\/][^\\\\/]+[\\\\/](requirements|design|tasks|bugfix)\\.md$/ && resourceFilename == 'tasks.md' && !notebookEditorFocused"
      }
    ]
  }
}
