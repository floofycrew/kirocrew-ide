{
  "schema": 1,
  "id": "kirocrew-ide",
  "name": "KiroCrew IDE",
  "version": "0.23.3",
  "description": "Use KiroCrew as your main IDE: a VS Code web engine (openvscode-server) runs as a loopback sidecar of the gateway and the full workbench is served same-origin inside the KiroCrew IDE App, with KiroCrew inside the IDE - chat with any crew agent, durable sessions that survive a dropped connection, tool approvals from the editor, and the Kiro spec workflow over .kiro/specs. Downloads the MIT engine from GitHub releases on your confirmation (the only network use). Unofficial.",
  "authors": [
    "Oscar Tseng"
  ],
  "license": "MIT",
  "icon": "ui/icon.svg",
  "tags": [
    "ide",
    "vscode",
    "editor",
    "productivity"
  ],
  "kirocrew": {
    "version": ">=0.7.0 <0.10.0",
    "editions": [
      "internal",
      "external"
    ],
    "strict": false
  },
  "dependsOn": {
    "floofycrew": "^1.2"
  },
  "recommends": {
    "kiro-spec-plan": ">=0.1.0"
  },
  "network": {
    "hosts": [
      "api.github.com",
      "github.com",
      "marketplace.visualstudio.com",
      "objects.githubusercontent.com",
      "open-vsx.org",
      "release-assets.githubusercontent.com"
    ],
    "credentials": false
  },
  "parts": [
    {
      "kind": "python-hook",
      "side": "gateway",
      "path": "hook/",
      "module": "hook",
      "early": true,
      "description": "IDE engine supervisor: spawns openvscode-server/code-server on 127.0.0.1; routes status/start/stop/engines; adopts a still-running engine across gateway restarts. early: installs the same-origin workbench proxy (a raw WebSocket-capable aiohttp route) so no second port needs forwarding on a remote host"
    },
    {
      "kind": "ui",
      "side": "spa",
      "path": "ui/",
      "entry": "ui/page.mjs",
      "title": "KiroCrew IDE",
      "icon": "ui/icon.svg",
      "description": "fallback control panel in the FloofyCrew App: engine status, folder, start/stop"
    },
    {
      "kind": "spa",
      "side": "spa",
      "path": "spa/layer.mjs",
      "activation": "runtime",
      "description": "the IDE layer: the one workbench iframe as a persistent element of the dashboard (never unmounted) that is fullscreen over KiroCrew, docked inside the KiroCrew IDE App page, or hidden; a '<host> IDE' chip in KiroCrew's crew switcher, and a title-bar tag stack that switches hosts, returns to this host's dashboard or exits fullscreen to the App page without reloading the IDE; a per-workspace spec-task completeness donut at the workbench's top right with a per-spec breakdown"
    },
    {
      "kind": "app",
      "side": "gateway",
      "path": "app/app.json",
      "description": "the KiroCrew IDE App: a first-class sidebar app whose page is the controller (engine install, folder, start/stop, Fullscreen) and the dock the spa layer shows the workbench in while the page is open"
    }
  ],
